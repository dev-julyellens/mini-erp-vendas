# Copie para config/.env e ajuste os valores.
# cp config/.env-example config/.env

# Banco de dados (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mini_erp_vendas
DB_USER=postgres
DB_PASSWORD=altere_sua_senha

# Aplicação
APP_BASE_URL=http://localhost/mini-erp-vendas/public
APP_TIMEZONE=America/Sao_Paulo
APP_ENV=local
APP_DEBUG=true

# Em produção: APP_ENV=production e APP_DEBUG=false (obrigatório)

# Logs (Monolog)
LOG_PATH=
LOG_LEVEL=warning

# API JWT — obrigatório com APP_DEBUG=false (mín. 32 caracteres, valor aleatório)
# Ex.: openssl rand -base64 48
JWT_SECRET=altere_para_um_segredo_longo_e_aleatorio_com_pelo_menos_32_chars
JWT_TTL=3600

# E-mail via PHPMailer (reset de senha e transacionais)
# driver: log (storage/logs/mail.log) | smtp | mail (sendmail do PHP)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Mini ERP de Vendas"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_AUTH=true
MAIL_SMTP_DEBUG=false

# Rate limit da API (requisições por janela em segundos)
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=60
API_LOGIN_RATE_LIMIT=10

# Backup (vazio = storage/backups dentro do projeto)
BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=
PSQL_PATH=

# Segurança e LGPD
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true
LGPD_POLICY_VERSION=2026-05-01
MASK_SENSITIVE_DATA=true

# PIX (gateway desacoplado; mock para desenvolvimento)
PIX_ENABLED=true
PIX_DEFAULT_GATEWAY=mock
PIX_CHARGE_TTL_SECONDS=3600
# Obrigatório em produção se usar PIX mock; em dev com APP_DEBUG=true pode ficar vazio
PIX_WEBHOOK_SECRET=
# Apenas staging: permite webhook mock com APP_DEBUG=false
PIX_MOCK_WEBHOOK_ENABLED=false
PIX_MERCHANT_NAME="Mini ERP"
PIX_MERCHANT_CITY="Sao Paulo"

# Mercado Pago (PIX real) — defina PIX_DEFAULT_GATEWAY=mercadopago em produção
# Access token: https://www.mercadopago.com.br/developers/panel/app
PIX_MERCADOPAGO_ACCESS_TOKEN=
# Secret do webhook (painel MP → Webhooks) para validar header x-signature
PIX_MERCADOPAGO_WEBHOOK_SECRET=
# E-mail do pagador exigido pela API (pode ser genérico da empresa)
PIX_MERCADOPAGO_PAYER_EMAIL=noreply@suaempresa.com.br
# URL de notificação no painel MP: {APP_BASE_URL}/webhooks/pix/mercadopago
