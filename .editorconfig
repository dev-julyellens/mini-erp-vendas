# EditorConfig — encoding e estilo base do repositório
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_style = space
indent_size = 4

[*.{php,js,css}]
indent_style = space
indent_size = 4

[composer.json]
indent_size = 4
