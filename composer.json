{
    "name": "mini-erp/vendas",
    "description": "Mini ERP de Vendas - PHP MVC + PostgreSQL",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "monolog/monolog": "^3.0",
        "phpoffice/phpspreadsheet": "^5.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
